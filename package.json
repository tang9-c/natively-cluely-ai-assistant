{
  "name": "cueup",
  "version": "2.7.3",
  "main": "dist-electron/electron/main.js",
  "description": "CueUp is a meeting notes app that uses AI to generate notes from your meetings.",
  "scripts": {
    "clean": "rimraf dist dist-electron",
    "dev": "vite",
    "build": "npm run clean && tsc && vite build",
    "build:electron": "node scripts/build-electron.js",
    "build:electron:package": "cross-env NATIVELY_ELECTRON_BUILD_MODE=package node scripts/build-electron.js",
    "build:electron:tsc": "tsc -p electron/tsconfig.json",
    "typecheck:electron": "tsc -p electron/tsconfig.json --noEmit",
    "preview": "vite preview",
    "postinstall": "node scripts/postinstall.js",
    "ensure:native": "node scripts/ensure-native-artifact.js",
    "electron:dev": "npm run ensure:native && npm run build:electron && cross-env NODE_ENV=development electron .",
    "electron:build": "npm run ensure:native && npm run build:electron && cross-env NODE_ENV=production electron .",
    "app:dev": "concurrently \"npm run dev -- --port 5180 --strictPort\" \"wait-on http://localhost:5180 && npm run electron:dev\"",
    "app:build": "npm run build && npm run build:electron:package && cross-env NATIVELY_BUILD_ALL_MAC_ARCHES=1 npm run build:native && node scripts/ensure-sharp-mac-deps.js && node scripts/ensure-canvas-mac-deps.js && electron-builder && node scripts/prepare-unsigned-macos-release.js",
    "watch": "tsc -p electron/tsconfig.json --watch",
    "start": "npm run app:dev",
    "dist": "npm run app:build",
    "build:native": "node scripts/build-native.js",
    "rebuild:native": "npx electron-rebuild -f -w better-sqlite3,keytar,sherpa-onnx-node && node scripts/ensure-sqlite-vec.js",
    "test": "npm run build:electron && ELECTRON_RUN_AS_NODE=1 npx electron --experimental-test-module-mocks --test $(find electron/services -path '*/__tests__/*.test.mjs') $(find electron/llm/__tests__ -name '*.test.mjs') $(find electron/rag/__tests__ -name '*.test.mjs')",
    "test:modes": "npm run build:electron && ELECTRON_RUN_AS_NODE=1 npx electron --test $(find electron/services/__tests__ -name 'Mode*.test.mjs') electron/services/__tests__/ProfileIntelligenceGate.test.mjs",
    "test:modes:no-build": "ELECTRON_RUN_AS_NODE=1 npx electron --test $(find electron/services/__tests__ -name 'Mode*.test.mjs') electron/services/__tests__/ProfileIntelligenceGate.test.mjs",
    "test:modes:collect-fixtures": "RUN_INTERNET_FIXTURE_COLLECTION=1 ELECTRON_RUN_AS_NODE=1 npx electron --test electron/services/__tests__/ModeFixtureIntegrity.test.mjs",
    "test:modes:e2e": "npm run test:modes",
    "test:modes:long": "ELECTRON_RUN_AS_NODE=1 npx electron --test electron/services/__tests__/ModeLongSession.test.mjs",
    "test:e2e": "ELECTRON_E2E=1 npx playwright test",
    "test:e2e:transcript-virtualization": "ELECTRON_E2E=1 npx playwright test tests/e2e/meeting-transcript-virtualization.spec.ts",
    "bench:long-meeting": "npm run build && npm run build:electron && node scripts/benchmark-long-meeting-memory.mjs",
    "benchmark:performance": "node scripts/run-performance-baseline.mjs",
    "perf:baseline:all": "node scripts/run-all-performance-baselines.mjs",
    "test:perf-baseline-orchestrator": "node --test scripts/__tests__/performance-baseline-orchestrator.test.mjs scripts/__tests__/run-performance-baseline.test.mjs",
    "benchmark:cold-start": "node scripts/benchmark-cold-start.mjs",
    "benchmark:dynamic-action": "node scripts/benchmark-qcloud-dynamic-action.mjs",
    "benchmark:qcloud-stt-renderer": "node scripts/benchmark-qcloud-stt-renderer.mjs",
    "perf:qcloud-stt-diagnostics": "node scripts/run-qcloud-stt-diagnostics-matrix.mjs",
    "benchmark:rag": "node scripts/benchmark-rag-query.mjs",
    "benchmark:stt": "node scripts/benchmark-stt-samples.mjs",
    "test:bench:long-meeting": "npm run build && npm run build:electron && node --test scripts/__tests__/benchmark-long-meeting-memory.test.mjs",
    "test:e2e:headed": "ELECTRON_E2E=1 npx playwright test --headed",
    "test:e2e:parity": "ELECTRON_E2E=1 ELECTRON_APP_PORT=${ELECTRON_APP_PORT:-5173} npx playwright test tests/e2e/parity-gaps-evidence.spec.ts",
    "test:doubao-auc:real": "node scripts/test-doubao-auc-real.mjs",
    "test:pptx-lite32k:real": "npm run build:electron && node scripts/test-pptx-lite32k-real.mjs",
    "test:business-mcp-agent:real": "npm run build:electron && node scripts/test-business-mcp-agent-real.mjs",
    "test:all": "node scripts/run-test-all.mjs",
    "test:quality:smoke": "npm run build:electron && npm run test:quality:smoke:no-build",
    "test:quality:smoke:no-build": "ELECTRON_RUN_AS_NODE=1 npx electron --experimental-test-module-mocks --test electron/services/__tests__/ModeEventClassifier.test.mjs electron/services/__tests__/DynamicActionEngine.test.mjs electron/services/__tests__/IntelligenceEngineDynamicActions.test.mjs electron/llm/__tests__/ModeAwareIntent.test.mjs electron/services/__tests__/AnswerTracePersistence.contract.test.mjs electron/services/__tests__/AnswerContextTraceContract.test.mjs electron/services/__tests__/RealtimeContextOrchestrator.test.mjs electron/services/__tests__/BusinessSystemEvalFixtures.test.mjs electron/services/__tests__/BusinessSystemFixedReplyGuard.test.mjs electron/services/__tests__/SpeakerContextPolicy.test.mjs electron/services/__tests__/AnswerQualityMetrics.test.mjs electron/services/eval/__tests__/AnswerMetricsOfflineHarness.test.mjs electron/services/__tests__/CodeHintScopeIpc.test.mjs electron/llm/__tests__/CodeHintLLM.test.mjs electron/services/__tests__/IntelligenceEngineCodeHint.test.mjs electron/services/__tests__/DocumentTextExtractor.test.mjs electron/services/__tests__/contextVisibilityMaterialRag.contract.test.mjs electron/services/__tests__/KnowledgeMaterialService.test.mjs electron/services/__tests__/RealtimeCitationIntegrity.test.mjs electron/services/__tests__/UploadedMaterialAnswerQuality.test.mjs electron/services/eval/__tests__/RealtimeAnswerTrustViewModel.test.mjs electron/services/__tests__/RealtimeDiagnosticsIpc.contract.test.mjs src/components/__tests__/KnowledgeMaterialsTrustUx.contract.test.mjs src/components/__tests__/NativelyInterfaceTrustUx.contract.test.mjs src/components/__tests__/DynamicActionTrustUx.contract.test.mjs",
    "test:quality:diagnostics": "npm run build:electron && npm run test:quality:diagnostics:no-build",
    "test:quality:diagnostics:no-build": "ELECTRON_RUN_AS_NODE=1 npx electron --test electron/services/eval/__tests__/ContextQualityDiagnostics.test.mjs electron/services/eval/__tests__/AnswerMetricsOfflineHarness.test.mjs && node scripts/context-quality-smoke-report.mjs",
    "test:quality:changed": "node scripts/context-quality-gate.mjs --list",
    "test:quality:gate": "node scripts/context-quality-gate.mjs --run",
    "test:quality:gate:no-build": "node scripts/context-quality-gate.mjs --run --no-build",
    "bench:screen-understanding": "npm run build:electron && node scripts/bench-screen-understanding.mjs",
    "bench:material-rag-candidates": "npm run build:electron && ELECTRON_RUN_AS_NODE=1 npx electron --test electron/services/__tests__/MaterialRagCandidateFiltering.bench.test.mjs",
    "test:dynamic-actions:product": "npm run build:electron && ELECTRON_RUN_AS_NODE=1 npx electron --test electron/services/qa/__tests__/DynamicActionFixtureRunner.test.mjs && node scripts/run-dynamic-actions-product.mjs",
    "test:dynamic-actions:replay": "npm run build:electron && ELECTRON_RUN_AS_NODE=1 npx electron --test electron/services/qa/__tests__/DynamicActionReplayRunner.test.mjs && node scripts/run-dynamic-actions-replay.mjs",
    "test:dynamic-actions:sales-replay:real-stt": "npm run build:electron && node scripts/run-sales-real-stt-replay.mjs",
    "test:dynamic-actions:fde-replay:real-stt": "npm run build:electron && node scripts/run-fde-real-stt-replay.mjs",
    "test:dynamic-actions:team-meet-replay:real-stt": "npm run build:electron && node scripts/run-team-meet-real-stt-replay.mjs",
    "test:dynamic-actions:recruiting-replay:real-stt": "npm run build:electron && node scripts/run-recruiting-real-stt-replay.mjs",
    "test:dynamic-actions:metrics": "npm run build:electron && ELECTRON_RUN_AS_NODE=1 npx electron --test electron/services/qa/__tests__/DynamicActionMetricsAggregator.test.mjs && node scripts/run-dynamic-actions-metrics.mjs",
    "test:coverage": "node scripts/coverage/run-c8.mjs",
    "test:coverage:baseline": "node scripts/coverage/baseline.mjs",
    "test:coverage:diff": "node scripts/coverage/diff-against-baseline.mjs",
    "test:coverage:threshold": "node scripts/coverage/check-threshold.mjs",
    "test:dynamic-actions:sales-replay:real-stt:local": "npm run build:electron && node scripts/run-sales-local-real-stt-smoke.mjs",
    "test:dynamic-actions:sales-replay:stt-benchmark:local": "npm run build:electron && node scripts/run-sales-local-stt-benchmark.mjs",
    "test:stt:doubao-corpus-fields:local": "npm run build:electron && node scripts/run-doubao-corpus-field-validation.mjs",
    "test:stt:benchmark:compare": "node scripts/compare-stt-benchmark-reports.mjs",
    "test:stt:qcloud-auc:matrix": "npm run build:electron && node scripts/run-stt-provider-matrix-local.mjs --providers qcloud-auc --parameter-groups all",
    "test:stt:provider-matrix:local": "npm run build:electron && node scripts/run-stt-provider-matrix-local.mjs",
    "test:stt:segmentation:unit": "npm run build:electron && node --test electron/audio/__tests__/SttSegmentation.test.mjs",
    "test:sales-transcript": "node tests/utils/sales-transcript-fixture-validator.mjs tests/fixtures/demo/03_master_transcript/sales/sales_full_lifecycle_meeting.json"
  },
  "build": {
    "generateUpdatesFilesForAllChannels": true,
    "appId": "com.electron.meeting-notes",
    "beforePack": "./scripts/before-pack.js",
    "afterPack": "./scripts/ad-hoc-sign.js",
    "productName": "CueUp",
    "electronLanguages": [
      "en",
      "en-US",
      "zh_CN",
      "zh-CN"
    ],
    "files": [
      "dist",
      "dist-electron",
      "native-module",
      "package.json",
      "!**/*.map",
      "!dist-electron/electron/test/**",
      "!dist-electron-test-isolated/**",
      "!**/native-module/target",
      "!**/native-module/src",
      "!**/native-module/.cargo",
      "!node_modules/electron/**",
      "!node_modules/electron-builder/**",
      "!node_modules/app-builder-bin/**",
      "!node_modules/electron-winstaller/**",
      "!node_modules/@electron/**",
      "!node_modules/@playwright/**",
      "!node_modules/typescript/**",
      "!node_modules/vite/**",
      "!node_modules/vite-plugin-electron/**",
      "!node_modules/vite-plugin-electron-renderer/**",
      "!node_modules/tailwindcss/**",
      "!node_modules/postcss/**",
      "!node_modules/autoprefixer/**",
      "!node_modules/concurrently/**",
      "!node_modules/wait-on/**",
      "!node_modules/rimraf/**",
      "!node_modules/@types/**",
      "!node_modules/**/.cache/**",
      "!node_modules/@huggingface/transformers/src/**",
      "!node_modules/@huggingface/transformers/types/**",
      "!node_modules/@huggingface/transformers/dist/ort-wasm*",
      "!node_modules/@huggingface/transformers/dist/transformers.js",
      "!node_modules/@huggingface/transformers/dist/transformers.min.js",
      "!node_modules/@huggingface/transformers/dist/transformers.web*",
      "!node_modules/better-sqlite3/bin/**",
      "!node_modules/better-sqlite3/deps/**",
      "!node_modules/better-sqlite3/src/**",
      "!node_modules/better-sqlite3/build/Release/obj/**",
      "!node_modules/better-sqlite3/build/Release/test_extension.node",
      "!node_modules/onnxruntime-node/bin/napi-v6/**",
      "node_modules/onnxruntime-node/bin/napi-v6/${env.NATIVELY_PACKAGE_PLATFORM}/${arch}/**",
      "!node_modules/sherpa-onnx-{darwin,linux,win}-*/**",
      "node_modules/sherpa-onnx-${env.NATIVELY_SHERPA_PLATFORM}-${arch}/**",
      "!node_modules/sqlite-vec-{darwin,windows,linux}-*/**",
      "node_modules/sqlite-vec-${env.NATIVELY_SQLITE_VEC_PLATFORM}-${arch}/**",
      "!node_modules/@img/*-{darwin,linux,linuxmusl,win32}-*/**",
      "node_modules/@img/*-${env.NATIVELY_PACKAGE_PLATFORM}-${arch}/**",
      "!node_modules/@napi-rs/*-{darwin,linux,win32}-*/**",
      "node_modules/@napi-rs/*-${env.NATIVELY_PACKAGE_PLATFORM}-${arch}*/**",
      "!native-module/*.node",
      "native-module/index.${env.NATIVELY_PACKAGE_PLATFORM}-${arch}*.node"
    ],
    "asarUnpack": [
      "dist-electron/electron/rag/vectorSearchWorker.js",
      "node_modules/bindings/**",
      "node_modules/file-uri-to-path/**",
      "**/*.node",
      "**/*.dylib",
      "**/*.dll"
    ],
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "extraResources": [
      {
        "from": "resources/models",
        "to": "models"
      },
      {
        "from": "assets/",
        "to": "assets/",
        "filter": [
          "**/*",
          "!natively-ai-meeting-assistant-demo.gif"
        ]
      },
      {
        "from": "assets/cueup.icns",
        "to": "cueup.icns"
      },
      {
        "from": "resources/skills",
        "to": "skills"
      },
      {
        "from": "resources/fonts",
        "to": "fonts"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "zip"
        },
        {
          "target": "dmg"
        }
      ],
      "icon": "assets/cueup.icns",
      "identity": null,
      "hardenedRuntime": false,
      "extendInfo": {
        "NSScreenCaptureUsageDescription": "CueUp needs Screen Recording permission to capture system audio for meeting transcription.",
        "NSMicrophoneUsageDescription": "CueUp needs microphone access to transcribe your voice during meetings.",
        "NSAudioCaptureUsageDescription": "CueUp needs system audio access to transcribe meeting audio."
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icons/win/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icons/png/",
      "category": "Office"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "tang9-c",
        "repo": "natively-cluely-ai-assistant",
        "releaseType": "release"
      }
    ]
  },
  "keywords": [],
  "author": "",
  "license": "AGPL-3.0",
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "@electron/rebuild": "^4.0.3",
    "@napi-rs/cli": "^3.5.1",
    "@playwright/test": "^1.59.1",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-toast": "^1.2.2",
    "@tanstack/react-query": "^5.100.10",
    "@tanstack/react-virtual": "^3.14.10",
    "@types/better-sqlite3": "^7.6.13",
    "@types/color": "^4.2.0",
    "@types/diff": "^6.0.0",
    "@types/electron": "^1.4.38",
    "@types/keytar": "^4.4.0",
    "@types/marked": "^5.0.2",
    "@types/node": "^22.9.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/screenshot-desktop": "^1.12.3",
    "@types/three": "^0.182.0",
    "@types/uuid": "^9.0.8",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.14.0",
    "@typescript-eslint/parser": "^8.14.0",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "dotenv": "^17.3.1",
    "electron": "^42.6.0",
    "electron-builder": "^26.8.1",
    "electron-is-dev": "^3.0.1",
    "electron-rebuild": "^3.2.9",
    "framer-motion": "^12.29.2",
    "katex": "^0.16.27",
    "liquid-glass-react": "^1.1.1",
    "lucide-react": "^0.460.0",
    "postcss": "^8.4.49",
    "react": "^19.2.6",
    "react-code-blocks": "^0.1.6",
    "react-dom": "^19.2.6",
    "react-icons": "^5.3.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^15.6.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "rimraf": "^6.0.1",
    "tailwind-merge": "^2.5.4",
    "tailwindcss": "^3.4.15",
    "tap": "^21.5.0",
    "three": "^0.182.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6",
    "wait-on": "^8.0.1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.74.0",
    "@bany/curl-to-json": "^1.2.10",
    "@deepgram/sdk": "^3.13.0",
    "@google-cloud/speech": "^7.2.1",
    "@google/genai": "^1.44.0",
    "@google/stitch-sdk": "^0.0.3",
    "@grpc/grpc-js": "^1.14.3",
    "@grpc/proto-loader": "^0.8.0",
    "@huggingface/transformers": "^3.8.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@tavily/core": "^0.7.2",
    "axios": "^1.7.7",
    "better-sqlite3": "12.11.1",
    "diff": "^7.0.0",
    "docx": "^9.7.1",
    "dompurify": "^3.4.14",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.7.3",
    "form-data": "^4.0.1",
    "groq-sdk": "^0.37.0",
    "jszip": "^3.10.1",
    "keytar": "^7.9.0",
    "mammoth": "^1.11.0",
    "marked": "^18.0.4",
    "onnxruntime-node": "1.22.0",
    "openai": "^6.22.0",
    "pdf-parse": "^2.4.5",
    "pptx-glimpse": "^3.2.0",
    "qrcode": "^1.5.4",
    "screenshot-desktop": "^1.15.0",
    "sharp": "^0.34.5",
    "sherpa-onnx-node": "^1.13.2",
    "sqlite-vec": "^0.1.7-alpha.2",
    "tesseract.js": "^5.0.5",
    "tree-kill": "^1.2.2",
    "uuid": "^11.0.3",
    "ws": "^8.19.0"
  },
  "optionalDependencies": {
    "sqlite-vec-darwin-arm64": "^0.1.7-alpha.2",
    "sqlite-vec-darwin-x64": "^0.1.7-alpha.2",
    "sqlite-vec-windows-x64": "^0.1.7-alpha.2"
  },
  "overrides": {
    "dompurify": "^3.4.11",
    "onnxruntime-node": "1.22.0"
  }
}
