      "start_ms": 285000,
      "end_ms": 298000,
      "scenario": "lecture",
      "text": "老师,能解释一下为什么不用 mod 哈希吗?具体说一下环式映射的好处?",
      "trigger_keywords": ["能解释", "具体说"],
      "expected_intent": "clarification",
      "expected_assist": "runClarify"
    },
    {
